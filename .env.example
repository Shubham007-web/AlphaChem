# Copy this file to .env and fill in real values. .env is gitignored.

# --- Standard OpenAI (PROVIDER = 'openai') ---
# Generate a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-new-key-here

# --- Azure OpenAI (PROVIDER = 'azure') ---
# Found in Azure Portal > your Azure OpenAI resource > Keys and Endpoint,
# and Azure AI Foundry > Deployments (the deployment name, not the base model name).
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
OPENAI_API_VERSION=2024-10-21

# --- Provider selection (default: azure) ---
# PROVIDER=azure        # azure | openai | ollama

# --- Arize Phoenix tracing (observability) ---
PHOENIX_TRACING=true
# Leave the next two blank to trace to a local Phoenix UI (http://localhost:6006,
# start it with: python -m phoenix.server.main serve).
# For Phoenix Cloud, set the collector endpoint and API key instead:
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# # PHOENIX_API_KEY=your-phoenix-api-key


# pip install -r requirements.txt                 # install Phoenix
# python -m phoenix.server.main serve             # terminal 1: starts UI at localhost:6006
# python src/core.py                              # terminal 2: run — traces stream to the UI